# ========================================
# HOSTINGER PRODUCTION ENVIRONMENT
# ========================================
# IMPORTANT: Acest fișier trebuie copiat ca .env pe Hostinger!
# Connection pooling este CRITIC pentru a evita "Too many connections"

# Environment
NODE_ENV=production
PORT=3000

# ========================================
# DATABASE - HOSTINGER MySQL
# ========================================
# CRITICAL: Connection pooling este configurat automat în db-config.ts
# Limită strictă: MAX 3 conexiuni simultane pentru shared hosting
DATABASE_URL="mysql://u596471450:PASSWORD_AICI@localhost:3306/u596471450_catalogsmart03"

# IMPORTANT: Înlocuiește PASSWORD_AICI cu parola MySQL reală de pe Hostinger!
# Găsești parola în: Hostinger Panel > Databases > phpMyAdmin

# ========================================
# AI APIs - OpenRouter cu Gemini
# ========================================
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model principal (Google Gemini 3 Flash pentru rapiditate + cost redus)
AI_MODEL=google/gemini-3-flash-preview
AI_MODEL_VISION=google/gemini-3-flash-preview

# ========================================
# Application URLs
# ========================================
NEXT_PUBLIC_SITE_URL=https://catalogsmart.ro
NEXT_PUBLIC_BASE_URL=https://catalogsmart.ro

# Storage path (relatif la root)
STORAGE_PATH=./storage

# ========================================
# Security Keys
# ========================================
# IMPORTANT: Schimbă aceste chei cu valori generate aleatoriu!
# Generează keys noi cu: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_CHARS_IN_PRODUCTION_USE_CRYPTO_RANDOM
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_32_CHARS_IN_PRODUCTION_USE_CRYPTO_RANDOM

# ========================================
# Cache Configuration (TTL în secunde)
# ========================================
# Cache-uri agresive pentru a reduce queries la DB
CACHE_TTL_DEFAULT=1800     # 30 min (default)
CACHE_TTL_PRODUCTS=7200    # 2 ore (products se actualizează rar)
CACHE_TTL_RECIPES=14400    # 4 ore (recipes sunt statice)

# ========================================
# External APIs
# ========================================
# Unsplash pentru imagini retete
UNSPLASH_ACCESS_KEY=cBLuRsRYCZ_N0jEKa541-ozFp1M46NmCdWYkGbPJpd8

# Google AdSense (opțional)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXX

# ========================================
# DEPLOYMENT NOTES
# ========================================
# 1. Copiază acest fișier ca .env pe Hostinger
# 2. Actualizează DATABASE_URL cu parola MySQL corectă
# 3. Generează keys noi pentru JWT_SECRET și SESSION_SECRET
# 4. Rulează: npm install && npm run build:prod
# 5. Pornește aplicația: npm start sau pm2 start npm -- start
#
# MONITORING:
# - Verifică conexiuni active: SHOW PROCESSLIST; în phpMyAdmin
# - Target: < 10 conexiuni active pentru aplicația ta
# - Dacă vezi "Too many connections", verifică că ai max 3 conexiuni în config
