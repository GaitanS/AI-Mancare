# Environment
NODE_ENV=production
PORT=3000

# Database (MySQL Hostinger)
DATABASE_URL="mysql://oferte_user:password@localhost:3306/oferte_retete_db"

# AI APIs
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Application
NEXT_PUBLIC_SITE_URL=https://retete-ieftine.ro
STORAGE_PATH=/home/u123456789/domains/retete-ieftine.ro/storage

# Security
JWT_SECRET=your_very_long_random_string_here_minimum_32_characters
SESSION_SECRET=another_random_string_minimum_32_characters

# AdSense (optional)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxx

# Email (pentru notificări - optional)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@retete-ieftine.ro
SMTP_PASS=your_email_password

# Scraping Configuration
SCRAPING_ENABLED=true
SCRAPING_CRON="0 2 * * 1"
RECIPE_GENERATION_CRON="0 6 * * 1"

# Rate Limiting
OPENAI_RATE_LIMIT_RPM=60
OPENAI_RATE_LIMIT_DELAY_MS=2000

# Cache Configuration
CACHE_TTL_DEFAULT=600
CACHE_TTL_PRODUCTS=3600
CACHE_TTL_RECIPES=7200
