# ===========================================
# ENVIRONMENT VARIABLES FOR P4 SCALING
# ===========================================
# Add these to your .env.local or hosting environment

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# Enable Redis caching (falls back to in-memory if unavailable)

# Option 1: Full Redis URL (recommended for cloud)
REDIS_URL=redis://username:password@localhost:6379/0

# Option 2: Individual settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_password
REDIS_DB=0

# ===========================================
# CDN CONFIGURATION
# ===========================================
# Enable CDN for static assets and images

# Enable/disable CDN
CDN_ENABLED=true

# CDN Base URL (choose one based on your provider)
# Cloudflare:
CDN_BASE_URL=https://retete-ieftine.ro

# Or imgix:
# CDN_BASE_URL=https://retete-ieftine.imgix.net

# Or AWS CloudFront:
# CDN_BASE_URL=https://d1234567890.cloudfront.net

# ===========================================
# IMAGE OPTIMIZATION
# ===========================================
# Configure image quality and optimization

# Enable Next.js Image Optimization (default: true)
NEXT_PUBLIC_IMAGE_OPTIMIZATION=true

# Image quality (1-100, default: 80)
IMAGE_QUALITY=80

# ===========================================
# HOSTING PROVIDERS WITH FREE REDIS
# ===========================================
# 
# 1. Upstash (Recommended - Serverless Redis)
#    - Free tier: 10,000 requests/day
#    - URL: https://upstash.com
#    - Use: REDIS_URL=rediss://xxx@xxx.upstash.io:6379
#
# 2. Railway
#    - Free tier: $5/month credit
#    - URL: https://railway.app
#
# 3. Render
#    - Free tier: Limited
#    - URL: https://render.com
#
# 4. Redis Cloud
#    - Free tier: 30MB
#    - URL: https://redis.com/try-free/
#
# ===========================================

# ===========================================
# CLOUDFLARE SETUP (FREE CDN)
# ===========================================
#
# 1. Go to https://cloudflare.com and add your domain
# 2. Update nameservers at your registrar
# 3. Enable these features:
#    - SSL/TLS: Full (Strict)
#    - Always Use HTTPS: ON
#    - Brotli: ON
#    - Early Hints: ON
#    - Auto Minify: JS, CSS, HTML
#    - Rocket Loader: Test before enabling
#    - Polish: Lossy
#    - Mirage: ON
#
# 4. Add Page Rules (see public/_headers file)
#
# ===========================================
