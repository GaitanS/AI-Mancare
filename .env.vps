# ========================================
# HOSTINGER VPS PRODUCTION ENVIRONMENT
# ========================================
# Optimized for VPS with multi-app support
# Application runs on port 3001 to avoid conflicts

# Environment
NODE_ENV=production
PORT=3001

# ========================================
# DATABASE - MySQL on VPS
# ========================================
# Create database and user with:
# CREATE DATABASE catalogsmart CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# CREATE USER 'catalogsmart_user'@'localhost' IDENTIFIED BY 'YOUR_SECURE_PASSWORD';
# GRANT ALL PRIVILEGES ON catalogsmart.* TO 'catalogsmart_user'@'localhost';
# FLUSH PRIVILEGES;

DATABASE_URL="mysql://catalogsmart_user:Frectie!234@localhost:3306/catalogsmart"

# VPS allows more connections than shared hosting
# Recommended: 10-20 connections for 8GB RAM VPS
# connection_limit is set in the URL params below

# ========================================
# AI APIs - OpenRouter with Gemini
# ========================================
OPENROUTER_API_KEY=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
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-3-flash-preview
AI_MODEL_VISION=google/gemini-3-flash-preview

# ========================================
# Application URLs
# ========================================
NEXT_PUBLIC_SITE_URL=https://catalogsmart.ro
NEXT_PUBLIC_BASE_URL=https://catalogsmart.ro

# Storage path (relative to app root)
STORAGE_PATH=./storage

# ========================================
# Security Keys
# ========================================
# IMPORTANT: Generate these with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_GENERATE_WITH_CRYPTO_RANDOM_BYTES_32
SESSION_SECRET=CHANGE_THIS_GENERATE_WITH_CRYPTO_RANDOM_BYTES_32

# ========================================
# Cache Configuration (TTL in seconds)
# ========================================
CACHE_TTL_DEFAULT=1800
CACHE_TTL_PRODUCTS=7200
CACHE_TTL_RECIPES=14400

# ========================================
# External APIs
# ========================================
UNSPLASH_ACCESS_KEY=cBLuRsRYCZ_N0jEKa541-ozFp1M46NmCdWYkGbPJpd8

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-4509784482094331
