# Disable LiteSpeed Cache for _next static files
<IfModule LiteSpeed>
    CacheLookup off
</IfModule>

# Serve correct MIME types
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType application/json .json
</IfModule>

# Enable CORS for static files
<FilesMatch "\.(css|js|json|png|jpg|jpeg|gif|svg|woff|woff2)$">
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>

# Ensure _next files are served correctly
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Pass through requests for _next static files
    RewriteCond %{REQUEST_URI} ^/_next/static/
    RewriteRule .* - [L]
</IfModule>
