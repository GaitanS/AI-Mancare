# ============================================
# CATALOGSMART - MARKETING & ANALYTICS CONFIG
# ============================================
# Copiază acest fișier ca .env.local și completează valorile

# ============================================
# GOOGLE ANALYTICS 4
# ============================================
# Obține din: https://analytics.google.com
# Mergi la: Admin → Data Streams → Web → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# GOOGLE SEARCH CONSOLE
# ============================================
# Obține din: https://search.google.com/search-console
# Verificare prin HTML tag
GOOGLE_VERIFICATION_ID=your_verification_code

# ============================================
# FACEBOOK PIXEL (pentru Ads)
# ============================================
# Obține din: https://business.facebook.com/events_manager
NEXT_PUBLIC_FB_PIXEL_ID=your_pixel_id

# ============================================
# SITE CONFIG
# ============================================
NEXT_PUBLIC_SITE_URL=https://catalogsmart.ro
NEXT_PUBLIC_SITE_NAME=CatalogSmart
NEXT_PUBLIC_BASE_URL=https://catalogsmart.ro

# ============================================
# SOCIAL MEDIA LINKS
# ============================================
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/catalogsmart
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/catalogsmart
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@catalogsmart
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/catalogsmart

# ============================================
# EMAIL / NEWSLETTER (opțional)
# ============================================
# Mailchimp
MAILCHIMP_API_KEY=your_api_key
MAILCHIMP_LIST_ID=your_list_id

# Sau Brevo (fost Sendinblue)
BREVO_API_KEY=your_api_key

# ============================================
# HOTJAR (Heatmaps - opțional)
# ============================================
NEXT_PUBLIC_HOTJAR_ID=your_hotjar_id

# ============================================
# INTERCOM / CHAT (opțional)
# ============================================
NEXT_PUBLIC_INTERCOM_APP_ID=your_intercom_id
