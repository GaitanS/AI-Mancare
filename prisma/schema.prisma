// Prisma Schema pentru Retete Ieftine
// SQLite pentru dezvoltare locală

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// PRODUCTS TABLE
// ==========================================
model Product {
  id        String   @id @default(uuid())
  name      String
  category  String
  subcategory String?
  brand     String?

  // Price Info
  price              Decimal
  originalPrice      Decimal? @map("original_price")
  discountPercentage Int?     @map("discount_percentage")
  unit               String   // kg, L, buc, 100g

  // Offer Details
  store      String
  validFrom  DateTime @map("valid_from")
  validUntil DateTime @map("valid_until")

  // AI Extracted Data (JSON)
  nutritionalInfo String? @map("nutritional_info") @db.Text
  allergens       String? @db.Text

  // Source Tracking
  sourceUrl             String? @map("source_url") @db.Text

// ... (Catalog model omitted as it looks fine mostly, mainly strings)
}

// ...

model Recipe {
  id          String @id @default(uuid())
  title       String
  description String @db.Text
  imageUrl    String? @map("image_url") @db.Text

  // ...

  // AI Generated Content (JSON stored as String)
  instructions String @db.LongText
  tips         String? @db.Text

  // Ingredients (JSON array stored as String)
  ingredientIds   String   @map("ingredient_ids") @db.Text
  
  // ...

  // Nutrition
  nutritionPerServing String? @map("nutrition_per_serving") @db.Text
  
  // SEO
  metaDescription String? @map("meta_description") @db.Text
  tags            String? @db.Text

  // ...
}

model WeeklyMenu {
  id     String  @id @default(uuid())
  
  // ...

  // Generated Menu (JSON stored as String)
  menuData     String  @map("menu_data") @db.LongText
  totalCost    Decimal? @map("total_cost")
  shoppingList String?  @map("shopping_list") @db.Text
  
  // ...
}

model ScrapingSource {
  // ...
  // Scraping Config (JSON stored as String)
  selectorConfig     String   @map("selector_config") @db.Text
  // ...
}

model User {
  // ...
  // Preferences (JSON stored as String)
  preferredStores      String?  @map("preferred_stores") @db.Text
  dietaryRestrictions  String?  @map("dietary_restrictions") @db.Text
  // ...
  excludedIngredients  String?  @map("excluded_ingredients") @db.Text
  // ...
}

model ShoppingCart {
  // ...
  // Cart Items (JSON stored as String)
  items String @default("[]") @db.Text
  // ...
}

// StoreMode: "OPTIMAL" | "SINGLE_STORE"

// ==========================================
// INGREDIENT MAPPING TABLE
// ==========================================
model IngredientMapping {
  id             String @id @default(uuid())
  ingredientName String @unique @map("ingredient_name")  // "iaurt", "smântână", "pui", etc.
  
  // Product matching config
  categoryMatch  String  @map("category_match")   // Product category to search in
  keywords       String  @map("keywords")         // JSON array of search terms
  defaultUnit    String  @default("buc") @map("default_unit")  // kg, L, buc, g
  
  // Aisle sorting for physical stores
  aisleOrder     Int     @default(99) @map("aisle_order")  // 1=Fructe/Legume, 2=Lactate, 3=Carne, etc.
  aisleName      String? @map("aisle_name")  // "Fructe și Legume", "Lactate", etc.
  
  // Dietary Flags
  isGlutenFree   Boolean @default(false) @map("is_gluten_free")
  isDairyFree    Boolean @default(false) @map("is_dairy_free")
  isVegan        Boolean @default(false) @map("is_vegan")
  isVegetarian   Boolean @default(false) @map("is_vegetarian")
  
  createdAt DateTime @default(now()) @map("created_at")
  
  @@index([categoryMatch])
  @@index([aisleOrder])
  
  @@map("ingredient_mappings")
}

// ==========================================
// USER PANTRY TABLE
// ==========================================
model UserPantry {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  sessionId String?  @map("session_id")
  
  // Pantry item details
  ingredientName String  @map("ingredient_name")
  quantity       Decimal?
  unit           String?
  
  // Tracking
  addedAt    DateTime  @default(now()) @map("added_at")
  expiresAt  DateTime? @map("expires_at")
  isAvailable Boolean  @default(true) @map("is_available")
  
  @@index([userId])
  @@index([sessionId])
  @@index([ingredientName])
  @@index([isAvailable])
  
  @@map("user_pantry")
}
