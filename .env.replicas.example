# ===========================================
# DATABASE READ REPLICAS - GHID CONFIGURARE
# ===========================================
#
# Acest ghid explică cum să configurezi replici de citire
# pentru a scala baza de date MySQL.
#
# ===========================================
# CE SUNT REPLICILE?
# ===========================================
#
# Master (Principal): Baza de date pentru SCRIERI (INSERT, UPDATE, DELETE)
# Replici: Copii ale bazei de date pentru CITIRI (SELECT)
#
# Fluxul:
#   1. Utilizator scrie → Master
#   2. Master sincronizează → Replici (0.1-1 secundă)
#   3. Utilizator citește → Replică (sau Master dacă replica e down)
#
# ===========================================
# OPȚIUNI DE SETUP
# ===========================================
#
# ----- OPȚIUNEA 1: PlanetScale (Recomandat) -----
# - MySQL serverless cu replici automate
# - Gratis: 5GB storage, 1B row reads/month
# - URL: https://planetscale.com
# 
# DATABASE_URL=mysql://xxx:xxx@aws.connect.psdb.cloud/retete?sslaccept=strict
# DATABASE_READ_URL=mysql://xxx:xxx@aws-ro.connect.psdb.cloud/retete?sslaccept=strict
#
# ----- OPȚIUNEA 2: Hostinger Cloud (Dacă ai deja) -----
# - Pe același server sau alt server
# - Trebuie să configurezi MySQL Replication manual
#
# DATABASE_URL=mysql://user:pass@master-ip:3306/retete
# DATABASE_REPLICA_1=mysql://user:pass@replica1-ip:3306/retete
# DATABASE_REPLICA_2=mysql://user:pass@replica2-ip:3306/retete
#
# ----- OPȚIUNEA 3: AWS RDS / DigitalOcean -----
# - Read Replicas automate
# - Costă mai mult dar e simplu
#
# ===========================================
# CONFIGURARE HOSTINGER (MANUAL)
# ===========================================
#
# PE MASTER (serverul principal):
#
# 1. Editează /etc/mysql/my.cnf:
#    [mysqld]
#    server-id = 1
#    log_bin = mysql-bin
#    binlog_format = ROW
#    binlog_do_db = retete_ieftine
#
# 2. Creează user pentru replicare:
#    CREATE USER 'replicator'@'%' IDENTIFIED BY 'parola_puternica';
#    GRANT REPLICATION SLAVE ON *.* TO 'replicator'@'%';
#    FLUSH PRIVILEGES;
#
# 3. Notează poziția binlog:
#    SHOW MASTER STATUS;
#    # Notează: File și Position
#
# PE REPLICA:
#
# 1. Editează /etc/mysql/my.cnf:
#    [mysqld]
#    server-id = 2
#    relay_log = relay-log
#    read_only = 1
#
# 2. Configurează slave:
#    CHANGE MASTER TO
#      MASTER_HOST='master-ip',
#      MASTER_USER='replicator',
#      MASTER_PASSWORD='parola_puternica',
#      MASTER_LOG_FILE='mysql-bin.000001',
#      MASTER_LOG_POS=154;
#
# 3. Pornește replicarea:
#    START SLAVE;
#    SHOW SLAVE STATUS\G
#
# ===========================================
# ENVIRONMENT VARIABLES
# ===========================================

# Master (pentru scrieri)
DATABASE_URL=mysql://user:password@master-host:3306/retete_ieftine

# Replici (pentru citiri) - adaugă câte vrei
DATABASE_REPLICA_1=mysql://user:password@replica1-host:3306/retete_ieftine
DATABASE_REPLICA_2=mysql://user:password@replica2-host:3306/retete_ieftine

# Sau o singură replică
DATABASE_READ_URL=mysql://user:password@read-host:3306/retete_ieftine

# ===========================================
# UTILIZARE ÎN COD
# ===========================================
#
# import { dbReader, dbWriter } from '@/lib/db-replicas'
#
# // Pentru citiri (SELECT) - folosește replica
# const products = await dbReader().product.findMany({
#   where: { store: 'Kaufland' }
# })
#
# // Pentru scrieri (INSERT/UPDATE) - folosește master
# const newProduct = await dbWriter().product.create({
#   data: { name: 'Lapte', price: 5.99 }
# })
#
# ===========================================
# MONITORIZARE
# ===========================================
#
# Verifică statusul replicilor:
# GET /api/admin/db-stats
#
# Răspuns:
# {
#   "master": { "healthy": true, "latency": 5 },
#   "replicas": {
#     "replica_1": { "healthy": true, "latency": 8 },
#     "replica_2": { "healthy": true, "latency": 12 }
#   }
# }
#
# ===========================================
